{
  "name": "endersbench-world",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:module": "cd spacetimedb && npm test",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:publish:local": "spacetime publish endersbench --module-path spacetimedb --server local --yes",
    "spacetime:reset:local": "spacetime publish endersbench --module-path spacetimedb --server local --delete-data=always --yes",
    "harness": "esbuild harness/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/main.js --log-level=warning && node dist-harness/main.js",
    "spacetime:publish:maincloud": "spacetime publish endersbench --module-path spacetimedb --server maincloud --yes",
    "world:pause": "spacetime call endersbench set_running false --server",
    "world:resume": "spacetime call endersbench set_running true --server",
    "report": "esbuild harness/report-main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/report.js --log-level=warning && node dist-harness/report.js",
    "record": "esbuild harness/record-main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/record.js --log-level=warning && node dist-harness/record.js",
    "results": "esbuild harness/results-main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/results.js --log-level=warning && node dist-harness/results.js",
    "dataset": "esbuild harness/dataset-main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/dataset.js --log-level=warning && node dist-harness/dataset.js",
    "headline": "npm run --silent results",
    "finance:bench": "esbuild harness/finance/run.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/finance-run.js --log-level=warning && node dist-harness/finance-run.js",
    "finance:live": "esbuild harness/finance/live.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/finance-live.js --log-level=warning && node dist-harness/finance-live.js",
    "finance:leaderboard": "esbuild harness/finance/leaderboard.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/finance-leaderboard.js --log-level=warning && node dist-harness/finance-leaderboard.js",
    "finance:label": "esbuild harness/finance/label.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/finance-label.js --log-level=warning && node dist-harness/finance-label.js",
    "finance:promote": "esbuild harness/finance/promote.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/finance-promote.js --log-level=warning && node dist-harness/finance-promote.js",
    "finance:export-labeling": "esbuild harness/finance/export-labeling.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/finance-export-labeling.js --log-level=warning && node dist-harness/finance-export-labeling.js",
    "finance:recording": "esbuild harness/finance/recording.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/finance-recording.js --log-level=warning && node dist-harness/finance-recording.js",
    "crs:live": "esbuild harness/finance/crscheck.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/crs-live.js --log-level=warning && node dist-harness/crs-live.js",
    "finance:score-labels": "esbuild harness/finance/score-labels.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/finance-score-labels.js --log-level=warning && node dist-harness/finance-score-labels.js",
    "benchmark:build": "esbuild harness/benchmark/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/benchmark-server.js && esbuild harness/benchmark/worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/benchmark-worker.js",
    "benchmark:server": "npm run benchmark:build && node --env-file-if-exists=.env.benchmark dist-harness/benchmark-server.js",
    "actors:build": "node actors/build.mjs",
    "actors:site": "esbuild actors/site/start.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-harness/site-start.js --log-level=warning && node dist-harness/site-start.js"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "spacetimedb": "2.13.*",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.24.2",
    "typescript": "~5.6.2",
    "vite": "^7.1.5",
    "vitest": "3.2"
  }
}
