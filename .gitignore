# Turbo Repo
.turbo

# endersbench: collected benchmark datasets (~192 MB of raw payloads).
# Keep the top-level README.md, MANIFEST.json, collect.py and the curated
# scenario catalogs; ignore the mirrors so they can be regenerated with
# `python3 ender/datasets/collect.py`.
/ender/datasets/*/
!/ender/datasets/alignment/
/ender/datasets/alignment/*
!/ender/datasets/alignment/README.md
!/ender/datasets/alignment/scenarios.jsonl
!/ender/datasets/clearing-altruism/
!/ender/datasets/clearing-runs/
!/ender/datasets/rewardhacking/
/ender/datasets/rewardhacking/*
!/ender/datasets/rewardhacking/README.md
!/ender/datasets/rewardhacking/scenarios.jsonl
# Keep the curated alignment-finance source (specs, schema, builder); the
# generated multi-megabyte rows stay out of git.
!/ender/datasets/alignment-finance/
/ender/datasets/alignment-finance/generated/
ender/datasets/alignment-finance/__pycache__/validate_dataset.cpython-313.pyc
ender/datasets/alignment-finance/__pycache__/validate_specs.cpython-313.pyc
voice.zip
